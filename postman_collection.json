{
  "info": {
    "name": "Eventos API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Eventos",
      "item": [
        {
          "name": "Listar eventos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos"
              ]
            }
          }
        },
        {
          "name": "Obtener evento",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/eventos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos",
                "1"
              ]
            }
          }
        },
        {
          "name": "Crear evento",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Concierto Rock\",\n  \"fecha\": \"2026-12-15\",\n  \"precio\": 25000\n}"
            }
          }
        },
        {
          "name": "Actualizar evento",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/eventos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos",
                "1"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Concierto Rock VIP\",\n  \"fecha\": \"2026-12-15\",\n  \"precio\": 30000\n}"
            }
          }
        },
        {
          "name": "Eliminar evento",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/eventos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos",
                "1"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Compras",
      "item": [
        {
          "name": "Comprar entradas",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/compras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "compras"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": 1,\n  \"cantidad\": 3\n}"
            }
          }
        },
        {
          "name": "Listar compras",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/compras",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "compras"
              ]
            }
          }
        },
        {
          "name": "Obtener compra",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/compras/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "compras",
                "1"
              ]
            }
          }
        }
      ]
    }
  ]
}