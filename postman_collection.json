{
  "info": {
    "name": "Eventos API",
    "description": "CRUD de eventos con ticket PDF en S3 (Exp2). Ejecuta las carpetas en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Eventos (CRUD)",
      "item": [
        {
          "name": "Crear evento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Concierto Rock\",\n  \"fecha\": \"2026-12-15\",\n  \"precio\": 25000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Crea el evento, genera su ticket PDF y lo sube a S3 (evento{id}/ticket.pdf). Guarda el id en la variable eventoId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"eventoId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar eventos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener evento",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos",
                "{{eventoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Descargar ticket PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{eventoId}}/ticket",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos",
                "{{eventoId}}",
                "ticket"
              ]
            },
            "description": "Lee el PDF desde S3. En Postman usa 'Save response > Save to a file' para guardarlo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es PDF\", () => pm.response.to.have.header(\"Content-Type\", \"application/pdf\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar evento",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos",
                "{{eventoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Concierto Rock - Nueva fecha\",\n  \"fecha\": \"2026-12-20\",\n  \"precio\": 30000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Actualiza el evento y regenera (sobrescribe) su ticket PDF en S3."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar evento",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{eventoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos",
                "{{eventoId}}"
              ]
            },
            "description": "Borra el ticket PDF de S3 y el evento de la base de datos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Casos de error",
      "item": [
        {
          "name": "Crear evento inválido (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"fecha\": null,\n  \"precio\": -1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener evento inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/99999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos",
                "99999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Descargar ticket de evento eliminado (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/eventos/{{eventoId}}/ticket",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos",
                "{{eventoId}}",
                "ticket"
              ]
            },
            "description": "Ejecutar después de 'Eliminar evento'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "eventoId",
      "value": "1"
    }
  ]
}